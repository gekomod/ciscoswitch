# ============================================================
#  WYMAGANE: dostęp do switcha i hasła
#  Wszystko inne ustawisz w panelu: Narzędzia → Ustawienia panelu.
# ============================================================

SWITCH_HOST=192.168.31.2
SWITCH_SSH_USER=manager
SWITCH_SSH_PASSWORD=CHANGE_ME
# Odcisk klucza SSH switcha (ssh-keyscan -t rsa IP | ssh-keygen -lf -)
SWITCH_SSH_HOST_KEY=SHA256:REPLACE_WITH_VERIFIED_FINGERPRINT

# SNMP: 2c (community) albo 3 (użytkownik SNMPv3)
SWITCH_SNMP_VERSION=2c
SWITCH_SNMP_COMMUNITY=CHANGE_ME_READONLY
# Tylko dla SNMPv3:
SWITCH_SNMP_V3_USER=
SWITCH_SNMP_V3_AUTH_PASSWORD=
SWITCH_SNMP_V3_PRIV_PASSWORD=

# Pierwsze konto administratora panelu (używane tylko do utworzenia data/users.json)
PANEL_USER=admin
PANEL_PASSWORD=CHANGE_TO_A_RANDOM_PASSWORD_AT_LEAST_16_CHARS

# Adres panelu w przeglądarce (127.0.0.1 = tylko ten komputer)
LISTEN_ADDR=127.0.0.1:8090


# ============================================================
#  OPCJONALNE: zwykle nie trzeba ich ustawiać
# ============================================================

# Porty, jeśli inne niż standardowe
# SWITCH_SSH_PORT=22
# SWITCH_SNMP_PORT=161

# Ustawienia z panelu (Narzędzia → Ustawienia panelu). Można je podać też tutaj
# jako wartości startowe; wartość zapisana w panelu ma pierwszeństwo.
# PROTECTED_PORTS=port1.0.1,port1.0.49
# ALLOW_PORT_SHUTDOWN=false
# ALLOW_MANAGEMENT_DHCP_CHANGE=false
# CONFIG_BACKUP_RETENTION=100
# SWITCH_SNMP_V3_PRIV_PROTOCOL=des
# SSH_COMMAND_TIMEOUT=30s
# STATUS_CACHE_TTL=5s
# READ_CACHE_TTL=5s
# PERF_LOG=false
# FIRMWARE_HTTP_ADDR=          (puste = wykrywany automatycznie)
# FIRMWARE_HTTP_PORT=8091

# Częstotliwość pracy w tle (0 wyłącza)
# MONITOR_INTERVAL=30s
# DIAGNOSTICS_INTERVAL=60s

# Ścieżki plików danych (domyślnie katalog data/)
# PANEL_SETTINGS_PATH=data/settings.json
# PANEL_USERS_PATH=data/users.json
# AUDIT_LOG_PATH=data/audit.jsonl
# CONFIG_BACKUP_DIR=data/config-backups
# PORT_PROFILES_PATH=data/port-profiles.json
# DIAGNOSTICS_HISTORY_PATH=data/diagnostics-history.json
# MONITOR_HISTORY_PATH=data/monitor-history.jsonl
# FIRMWARE_DIR=data/firmware
# NOTIFY_PATH=data/notify.json
