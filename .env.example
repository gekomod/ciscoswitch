SWITCH_HOST=192.168.31.2
SWITCH_SSH_PORT=22
SWITCH_SSH_USER=manager
SWITCH_SSH_PASSWORD=CHANGE_ME
# SHA256 fingerprint from a trusted local console / ssh-keyscan verification
SWITCH_SSH_HOST_KEY=SHA256:REPLACE_WITH_VERIFIED_FINGERPRINT
SWITCH_SNMP_COMMUNITY=CHANGE_ME_READONLY
SWITCH_SNMP_PORT=161
# Monitoring mode: 2c (legacy community) or 3 (SNMPv3 authPriv)
SWITCH_SNMP_VERSION=2c
# Required only when SWITCH_SNMP_VERSION=3; use the SNMPv3 user created in the panel
SWITCH_SNMP_V3_USER=
SWITCH_SNMP_V3_AUTH_PASSWORD=
SWITCH_SNMP_V3_PRIV_PASSWORD=
# Szyfrowanie SNMPv3: des (domyślnie) lub aes — musi zgadzać się z użytkownikiem na switchu
SWITCH_SNMP_V3_PRIV_PROTOCOL=des
LISTEN_ADDR=127.0.0.1:8090
# Konto bootstrap używane tylko do utworzenia pierwszego administratora.
# Po utworzeniu data/users.json logowanie odbywa się z rejestru, a te wartości można usunąć.
PANEL_USER=admin
PANEL_PASSWORD=CHANGE_TO_A_RANDOM_PASSWORD_AT_LEAST_16_CHARS
# Rola konta początkowego; po utworzeniu rejestru role zmienia administrator w panelu.
PANEL_ROLE=admin
# Lokalny rejestr kont (bcrypt hashes; katalog 0700, plik 0600).
PANEL_USERS_PATH=data/users.json

# Local JSONL audit trail (metadata only; no request bodies or secrets)
AUDIT_LOG_PATH=data/audit.jsonl

# Safety: disabling ports is blocked unless explicitly enabled
ALLOW_PORT_SHUTDOWN=false
# Comma-separated interfaces that must never be modified by this panel.
# Set the real management/uplink interfaces after verifying the switch cabling, e.g. port1.0.49,port1.0.52.
# The panel does not guess the management port automatically.
PROTECTED_PORTS=

# Safety: management VLAN DHCP changes require explicit opt-in
ALLOW_MANAGEMENT_DHCP_CHANGE=false

# Local saved port profile library (Access/Trunk templates)
PORT_PROFILES_PATH=data/port-profiles.json

# Local bounded history of switch topology/LACP diagnostic samples (file mode 0600)
DIAGNOSTICS_HISTORY_PATH=data/diagnostics-history.json

# Background read-only switch diagnostics sampling (10s minimum; 0 disables)
DIAGNOSTICS_INTERVAL=60s

# Server-side monitoring of SNMP availability, link changes and port error counters.
# Runs without an open browser; 10s minimum, 0 disables. History is local JSONL.
MONITOR_INTERVAL=30s
MONITOR_HISTORY_PATH=data/monitor-history.jsonl

# Wydajność: czas życia cache stanu portów (SNMP) i wyników poleceń show (SSH).
# Puste = 5s, "0" wyłącza cache. Każda zmiana konfiguracji z panelu czyści cache.
STATUS_CACHE_TTL=5s
READ_CACHE_TTL=5s
# PERF_LOG=1 loguje czas każdego zapytania do switcha; bez tego logowane są tylko zapytania > 1,5 s.
PERF_LOG=0
