SWITCH_HOST=192.168.31.2
SWITCH_SSH_PORT=22
SWITCH_SSH_USER=manager
SWITCH_SSH_PASSWORD=CHANGE_ME
# SHA256 fingerprint from a trusted local console / ssh-keyscan verification
SWITCH_SSH_HOST_KEY=SHA256:REPLACE_WITH_VERIFIED_FINGERPRINT
SWITCH_SNMP_COMMUNITY=CHANGE_ME_READONLY
SWITCH_SNMP_PORT=161
# Monitoring mode: 2c (legacy community) or 3 (SNMPv3 authPriv)
SWITCH_SNMP_VERSION=2c
# Required only when SWITCH_SNMP_VERSION=3; use the SNMPv3 user created in the panel
SWITCH_SNMP_V3_USER=
SWITCH_SNMP_V3_AUTH_PASSWORD=
SWITCH_SNMP_V3_PRIV_PASSWORD=
LISTEN_ADDR=127.0.0.1:8090
PANEL_USER=admin
PANEL_PASSWORD=CHANGE_TO_A_RANDOM_PASSWORD_AT_LEAST_16_CHARS

# Local JSONL audit trail (metadata only; no request bodies or secrets)
AUDIT_LOG_PATH=data/audit.jsonl

# Safety: disabling ports is blocked unless explicitly enabled
ALLOW_PORT_SHUTDOWN=false
# Comma-separated interfaces that must never be modified by this panel
PROTECTED_PORTS=

# Safety: management VLAN DHCP changes require explicit opt-in
ALLOW_MANAGEMENT_DHCP_CHANGE=false
